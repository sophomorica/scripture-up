# Scripture Up — TestFlight only.
#
#   ./scripts/cut_release.sh test ios
#
# No App Store submit lane. Do not add `lane :release`.

REPO_ROOT = File.expand_path("../..", __dir__)
BUNDLE_ID = "com.narrowroad.scriptureup"

def require_asc_env!
  missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].select { |v| ENV[v].to_s.strip.empty? }
  unless missing.empty?
    UI.user_error!(<<~MSG)
      Missing env: #{missing.join(', ')}.
      The .p8 lives outside the repo, in business/narrow-road-keys/.
      ./scripts/cut_release.sh sources asc-api.env when those vars are unset.
    MSG
  end
  key_path = File.expand_path(ENV["ASC_KEY_PATH"])
  UI.user_error!("ASC_KEY_PATH points to #{key_path} but there is no file there.") unless File.exist?(key_path)
end

def pubspec_version
  File.read(File.join(REPO_ROOT, "pubspec.yaml"))[/^version:\s*(\S+)/, 1]
end

def make_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: File.expand_path(ENV["ASC_KEY_PATH"])
  )
end

def find_ipa!
  ipa = Dir[File.join(REPO_ROOT, "build", "ios", "ipa", "*.ipa")].max_by { |f| File.mtime(f) }
  UI.user_error!("No .ipa under build/ios/ipa/ — did build_ios_release.sh succeed?") unless ipa
  ipa
end

def build_ipa!
  sh("bash", File.join(REPO_ROOT, "scripts", "build_ios_release.sh"))
  find_ipa!
end

platform :ios do
  desc "Build IPA and upload to TestFlight. Does not submit for App Store review."
  lane :internal do
    require_asc_env!

    version = pubspec_version
    build_number = version.to_s.split("+", 2)[1]
    api_key = make_api_key
    ipa = build_ipa!

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
      changelog: "Internal TestFlight build #{version}."
    )

    UI.success("#{version} uploaded to TestFlight (build #{build_number}).")
    UI.success("Install from TestFlight. This repo has no App Store submit lane.")
  end
end
